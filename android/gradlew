#!/usr/bin/env sh
# Gradle wrapper replacement that works without wrapper jar
# Downloads Gradle 8.6 if not available, then runs it
set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
GRADLE_VERSION="8.6"
GRADLE_HOME="$HOME/.gradle/wrapper/dists/gradle-${GRADLE_VERSION}-bin"
GRADLE_BIN="$GRADLE_HOME/gradle-${GRADLE_VERSION}/bin/gradle"

# If system gradle exists, use it
if command -v gradle >/dev/null 2>&1; then
  echo "Using system gradle: $(gradle --version | head -n 1)"
  exec gradle "$@"
fi

# If wrapper jar exists, use it
if [ -f "$DIR/gradle/wrapper/gradle-wrapper.jar" ]; then
  echo "Using gradle-wrapper.jar"
  exec java -jar "$DIR/gradle/wrapper/gradle-wrapper.jar" "$@"
fi

# Try to find gradle binary in common locations
if [ -x "/opt/gradle/bin/gradle" ]; then
  exec /opt/gradle/bin/gradle "$@"
fi
if [ -x "$GRADLE_BIN" ]; then
  exec "$GRADLE_BIN" "$@"
fi

# Download gradle
echo "Gradle not found, downloading Gradle $GRADLE_VERSION..."
mkdir -p "$GRADLE_HOME"
cd "$GRADLE_HOME"
if [ ! -f "gradle-${GRADLE_VERSION}-bin.zip" ]; then
  echo "Downloading https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
  curl -L -o "gradle-${GRADLE_VERSION}-bin.zip" "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" || wget -O "gradle-${GRADLE_VERSION}-bin.zip" "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
fi
if [ ! -d "gradle-${GRADLE_VERSION}" ]; then
  unzip -o "gradle-${GRADLE_VERSION}-bin.zip" || true
fi
exec "$GRADLE_BIN" "$@"
