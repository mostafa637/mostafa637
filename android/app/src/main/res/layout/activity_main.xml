<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Toolbar for extra keys - matches BarButton + ArrowBarButton -->
    <LinearLayout
        android:id="@+id/extraKeysBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FF222222"
        android:padding="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnTab"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/tab"
            android:textSize="14sp"
            style="@style/Widget.Material3.Button.TonalButton" />

        <Button
            android:id="@+id/btnCtrl"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/ctrl"
            android:textSize="14sp"
            style="@style/Widget.Material3.Button.TonalButton" />

        <Button
            android:id="@+id/btnEsc"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/esc"
            android:textSize="14sp"
            style="@style/Widget.Material3.Button.TonalButton" />

        <Button
            android:id="@+id/btnUp"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/up"
            android:textSize="18sp"
            style="@style/Widget.Material3.Button.TonalButton" />

        <Button
            android:id="@+id/btnDown"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/down"
            android:textSize="18sp"
            style="@style/Widget.Material3.Button.TonalButton" />

        <Button
            android:id="@+id/btnLeft"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/left"
            android:textSize="18sp"
            style="@style/Widget.Material3.Button.TonalButton" />

        <Button
            android:id="@+id/btnRight"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/right"
            android:textSize="18sp"
            style="@style/Widget.Material3.Button.TonalButton" />
    </LinearLayout>

    <!-- Terminal WebView - matches Terminal.m WKWebView with xterm.js -->
    <WebView
        android:id="@+id/terminalWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/black"
        app:layout_constraintTop_toBottomOf="@id/extraKeysBar"
        app:layout_constraintBottom_toTopOf="@id/statusBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Status bar - matches iOS status + theme info -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FF111111"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="iSH - Alpine Linux 3.18 | Default theme | ui-monospace 12px | BLOCK"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/clear"
            android:textSize="10sp"
            style="@style/Widget.Material3.Button.TextButton" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
