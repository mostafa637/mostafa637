<?xml version="1.0" encoding="UTF-8"?>
<app xmlns="https://sp1rit.arpa/pixiewood/" xmlns:xi="http://www.w3.org/2001/XInclude">
  <metainfo vercalc="count">
    <xi:include href="src://data/com.example.GtkHelloWorld.metainfo.xml" parse="xml" />
  </metainfo>

  <style>
    <theme name="gtk" />
    <icon type="generate">
      <drawable target="foreground" type="avd" path="src://data/icon.avd.xml" />
      <color target="background">#2563EB</color>
    </icon>
  </style>

  <dependencies>
    <glib>
      <patch>hack</patch>
    </glib>
    <fontconfig />
    <gtk />
  </dependencies>

  <build target="gtk-hello-android" java-sources="src/android-java">
    <architectures>
      <arch>aarch64</arch>
      <arch>x86_64</arch>
    </architectures>
  </build>
</app>
